# ================================================= #
# ******** 服务 *********** #
# ================================================= #
BASE_URL=http://127.0.0.1:8100
# FRONTEND_BASE_URL=http://127.0.0.1:5173

# ================================================= #
# ******** 安全 / JWT *********** #
# ================================================= #
# 生产环境务必更换；开发环境固定值避免重启导致 token 失效
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================================= #
# ******** Redis *********** #
# ================================================= #

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=4

# ================================================= #
# ******** 数据库 *********** #
# ================================================= #
# mysql-3306 / postgres-5432 / sqlite（sqlite 时 DATABASE_NAME 为文件名，如 ntester.db）
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_NAME=ntester

# 建表配置
DB_AUTO_INIT=true
ENVIRONMENT=dev

# ================================================= #
# ******** Celery（建议与业务 Redis 认证一致，DB 号可不同） *********** #
# ================================================= #
CELERY_BROKER_URL=redis://localhost:6379/5
CELERY_RESULT_BACKEND=redis://localhost:6379/5
# CELERY_BEAT_DB_URL=  # 使用 DB_* 时可不填，自动复用

# ================================================= #
# ******** 验证码 *********** #
# ================================================= #
CAPTCHA_ENABLE=true
CAPTCHA_EXPIRE_SECONDS=60
CAPTCHA_LENGTH=4

# ================================================= #
# ******** OAuth *********** #
# ================================================= #
GRANT_ADMIN_TO_OAUTH_USER=false
GITEE_CLIENT_ID=your-gitee-client-id
GITEE_CLIENT_SECRET=your-gitee-client-secret
GITEE_REDIRECT_URI=http://localhost:3000/oauth/gitee/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/oauth/github/callback
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key
QQ_REDIRECT_URI=http://localhost:3000/oauth/qq/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_REDIRECT_URI=http://localhost:3000/oauth/wechat/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback
DINGTALK_APP_ID=your-dingtalk-app-id
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_REDIRECT_URI=http://localhost:3000/oauth/dingtalk/callback
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_REDIRECT_URI=http://localhost:3000/oauth/feishu/callback

# ================================================= #
# ******** APP 自动化 *********** #
# ================================================= #
# APP_PROJECT_ROOT=
# PROJECT_PATH=
# APP_PUBLIC_BASE_URL=http://127.0.0.1:8100
# APP_DEVICE_RM_PATHS=
# APP_SMS_BODY_KEYWORD=识别文案
# USE_APPIUM_APP_EXECUTOR=
APPIUM_SERVER_URL=http://127.0.0.1:4723
APP_TEMPLATE_ROOT=backend

# ================================================= #
# ******** MinIO *********** #
# ================================================= #
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your-login-admin
MINIO_SECRET_KEY=your-login-password
MINIO_SECURE=False
MINIO_BUCKET=performance

# ================================================= #
# ******** SSH（压力机分发） *********** #
# ================================================= #
PLATFORM_SSH_KEY_PATH=/root/.ssh/id_rsa
DEFAULT_SSH_KEY_PATH=/root/.ssh/id_rsa

# ================================================= #
# ******** 脚本执行 *********** #
# ================================================= #
# sandbox=沙盒（默认）；native=本机 Python/Node
SCRIPT_EXEC_MODE=sandbox
SCRIPT_NATIVE_PYTHON=python
SCRIPT_NATIVE_NODE=node
# SCRIPT_NATIVE_TIMEOUT=30
